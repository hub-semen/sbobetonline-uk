{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbobetonline-uk",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-16",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
